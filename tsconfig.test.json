{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "example/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
